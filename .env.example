# ── Environment ────────────────────────────────────────────────────────────────
APP_ENV=paper                      # paper | testnet | live | backtest | dex
APP_SECRET=change_me_in_production

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path inside container (mounted volume)
DATABASE_PATH=/app/data/trading.db
# PostgreSQL URL (for future migration — not implemented yet)
# DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/mktrader

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for future pub/sub and job queue — optional for now
REDIS_URL=redis://redis:6379/0

# ── Exchange ──────────────────────────────────────────────────────────────────
EXCHANGE_PROVIDER=binance
DEFAULT_SYMBOL=BTCUSDT
TIMEFRAME=15m
POLL_INTERVAL_SECONDS=60

# ── Trading ───────────────────────────────────────────────────────────────────
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Risk ─────────────────────────────────────────────────────────────────────
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=5
MAX_EXPOSURE=1000
MAX_CONSECUTIVE_LOSSES=3
MIN_SIGNAL_CONFIDENCE=0.70
MAX_DRAWDOWN_PCT=0.15

# ── Strategy ──────────────────────────────────────────────────────────────────
STRATEGY=indicator
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
BB_PERIOD=20
ADX_PERIOD=14

# ── API ──────────────────────────────────────────────────────────────────────
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=60
API_REQUIRE_HTTPS=false
API_AUDIT_LOG_DIR=./audit

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_API_TOKEN=                   # Set in production — do NOT commit real values
CONTROL_API_TOKEN=
ENABLE_REMOTE_CONTROL=false

# ── Telegram ─────────────────────────────────────────────────────────────────
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Binance Square ────────────────────────────────────────────────────────────
ENABLE_BINANCE_SQUARE=false
BINANCE_SQUARE_API_KEY=
BINANCE_SQUARE_ENDPOINT=https://www.binance.com/bapi/composite/v1/public/pgc/openApi/content/add
BINANCE_SQUARE_DAILY_LIMIT=95
BINANCE_SQUARE_STATE_DIR=./data

# ── Binance Hyperliquid / DEX ────────────────────────────────────────────────
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WALLET_ADDRESS=
WALLETCONNECT_PROJECT_ID=
DEX_CHAIN_ID=
DEX_RPC_URL=

# ── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
LOG_LEVEL=INFO

# ── Data retention ───────────────────────────────────────────────────────────
RETENTION_DAYS=90
ALERT_FAILURE_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=900
